     std::lock_guard lock(m_surfaceMutex);
 
-    if (status != VK_SUCCESS) {
+    // GeneralsX @bugfix Android port 05/08/2026 We always request preTransform
+    // = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR (see createSwapchain() below) and
+    // never inspect the surface's actual currentTransform. On Android devices
+    // whose compositor reports a non-identity currentTransform for this app's
+    // orientation, that mismatch is permanent: the image still composites
+    // correctly (the compositor absorbs the extra rotation itself), but every
+    // single vkQueuePresentKHR legitimately returns VK_SUBOPTIMAL_KHR forever.
+    // Recreating the swapchain doesn't fix that -- the new one still requests
